{
  "name": "us-federal-tax",
  "version": "0.1.0",
  "description": "Dependency-free US federal tax engine: income tax brackets, self-employment tax, FICA, capital gains, NIIT and quarterly estimated payments. Every figure cited to the IRS release it came from.",
  "keywords": [
    "tax",
    "taxes",
    "us-tax",
    "federal-tax",
    "income-tax",
    "tax-brackets",
    "self-employment-tax",
    "payroll",
    "fica",
    "medicare",
    "social-security",
    "capital-gains",
    "niit",
    "estimated-tax",
    "quarterly-taxes",
    "1099",
    "freelancer",
    "irs",
    "2026"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/finalize.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
