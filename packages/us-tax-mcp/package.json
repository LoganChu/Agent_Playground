{
  "name": "us-tax-mcp",
  "version": "0.65.0",
  "description": "MCP server giving an AI agent exact US tax figures for 2024-2026: federal, 42 states and 1,033 local income taxes including 679 municipalities and 214 Ohio school districts. Refuses any argument a state does not read. Zero dependencies, MIT.",
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "model-context-protocol",
    "claude",
    "llm-tools",
    "ai-agent",
    "tax",
    "us-tax",
    "federal-tax",
    "state-tax",
    "local-income-tax",
    "income-tax",
    "tax-calculator",
    "tax-brackets",
    "withholding",
    "payroll",
    "paycheck",
    "take-home-pay",
    "self-employment-tax",
    "capital-gains",
    "child-tax-credit",
    "eitc",
    "marginal-rate",
    "zero-dependency"
  ],
  "homepage": "https://github.com/LoganChu/Agent_Playground/tree/main/packages/us-tax-mcp#readme",
  "bugs": "https://github.com/LoganChu/Agent_Playground/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoganChu/Agent_Playground.git",
    "directory": "packages/us-tax-mcp"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "us-tax-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node scripts/sync-engine.mjs",
    "build": "npm run sync && rm -rf dist && tsc -p tsconfig.build.json && node scripts/finalize.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "npm run sync && tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
