    "tax-calculator",
    "tax-brackets",
    "city-income-tax",
    "county-income-tax",
    "school-district-income-tax",
    "payroll",
    "paycheck",
    "withholding",
    "take-home-pay",
    "marginal-rate",
    "effective-tax-rate",
    "state-eitc",
    "pension-exclusion",
    "retirement-income",
    "new-york-city",
    "maryland-counties",
    "ohio-municipal-income-tax",
    "indiana-counties",
    "zero-dependency"
  ],
  "homepage": "https://github.com/LoganChu/Agent_Playground/tree/main/packages/us-state-tax#readme",
  "bugs": "https://github.com/LoganChu/Agent_Playground/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoganChu/Agent_Playground.git",
    "directory": "packages/us-state-tax"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/finalize.mjs --guard-only && rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/finalize.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
